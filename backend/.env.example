# Ollama: yerel, ücretsiz LLM sunucusu — API anahtarı gerekmez.
# Kurulum: https://ollama.com — sonra `ollama pull qwen2.5:7b`
# Daha hafif/hızlı ama Türkçe kalitesi daha zayıf bir alternatif: llama3.2:3b
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Yoğun gömme modeli (sentence-transformers kuruluysa kullanılır)
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Veri dizini
DATA_DIR=./data

# CORS için izin verilen frontend adresi
FRONTEND_ORIGIN=http://localhost:3000
